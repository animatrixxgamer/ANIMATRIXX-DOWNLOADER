# ------------------------------------------------------------------
# Animatrixx Anime Bot - environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ------------------------------------------------------------------

# Required. Get it from @BotFather -> /newbot
BOT_TOKEN=

# Required. Your numeric Telegram user id (ask @userinfobot).
OWNER_ID=0

# Optional. Comma-separated extra administrator ids, e.g. 111111111,222222222
ADMIN_IDS=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/animatrixx.db

# Working directories (created at startup)
TEMP_DIR=./temp
LOG_DIR=./logs
LOG_LEVEL=INFO

# Metadata providers
# AniList needs no key. TMDB is used for K-drama / movie metadata.
TMDB_API_KEY=
METADATA_CACHE_TTL=3600

# ------------------------------------------------------------------
# Pipeline (download / encode / upload) - all enforced by the implementation
# ------------------------------------------------------------------
# Concurrency per stage (encoding is CPU bound - keep it at 1 on small VPSes)
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_ENCODINGS=1
MAX_CONCURRENT_UPLOADS=2
MAX_JOBS_PER_USER=2

# Safety limits
MAX_DOWNLOAD_SIZE_MB=2048
MIN_FREE_DISK_MB=2048
ALLOWED_DOWNLOAD_PORTS=80,443
# Development only: lets the downloader reach a local HTTP server.
ALLOW_PRIVATE_DOWNLOADS=false

# Retries: exponential backoff, permanent errors (403/404/bad file) never retried
MAX_JOB_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=30

# Encoding
# DEFAULT_ENCODING_PROFILE: original | high | balanced | small | target
DEFAULT_OUTPUT_FORMAT=mp4
DEFAULT_ENCODING_PROFILE=balanced
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
ENCODE_TIMEOUT_SECONDS=3600

# Temp-file cleanup after a successful archive
AUTODEL_ENABLED=true
AUTODEL_HOURS=24

# Telegram upload ceiling. The hosted Bot API caps bot uploads far below
# large anime files (~50 MB); enable a Local Bot API Server for bigger ones.
TELEGRAM_UPLOAD_LIMIT_MB=49
UPLOAD_TIMEOUT_SECONDS=600

# Local Bot API Server (see README section 10 and docker-compose.localapi.yml).
# Inside the compose network use http://telegram-bot-api:8081/...
LOCAL_BOT_API_ENABLED=false
LOCAL_BOT_API_BASE_URL=http://localhost:8081/bot
LOCAL_BOT_API_FILE_URL=http://localhost:8081/file/bot
LOCAL_BOT_API_MAX_MB=2000

# Dispatcher pacing (seconds)
POLL_INTERVAL_SECONDS=2
PROGRESS_UPDATE_INTERVAL=2

# Local Bot API Server credentials (only needed when LOCAL_BOT_API_ENABLED=true)
# Obtain at https://my.telegram.org -> API development tools
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
